{
  "name": "thru-ledger-export",
  "version": "0.3.0",
  "description": "Export a Thru account's transaction history to CSV or JSON for bookkeeping, audit and analysis.",
  "type": "module",
  "bin": { "thru-ledger-export": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": ["thru", "blockchain", "csv", "accounting", "audit", "export", "explorer"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
